# Copy this file to ".env" and change the values.

# Signs login tokens. Use a long random string (generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))" )
SECRET_KEY=change-me-to-a-long-random-string

# Default: a local SQLite file. For PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://chat:chat@localhost:5432/chat
DATABASE_URL=sqlite:///./chat.db

# Largest file people can send, in MB
MAX_UPLOAD_MB=25

# 127.0.0.1 = only this computer. 0.0.0.0 = other devices on your Wi-Fi can join too.
HOST=127.0.0.1
PORT=8000
